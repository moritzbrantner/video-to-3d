{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": [
      "format:check",
      "lint",
      "typecheck",
      "test"
    ],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "test",
      "build",
      "test:integration:workflow"
    ],
    "performance": [
      "benchmark:smoke"
    ]
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "typecheck",
    "test",
    "build",
    "test:integration:workflow"
  ],
  "optionalCapabilities": [
    "benchmark:smoke"
  ],
  "capabilityCommands": {
    "video-to-3d": {
      "format:check": [
        "bash",
        "-lc",
        "cargo fmt --check && cargo fmt --manifest-path crates/video-to-3d-feature-wasm/Cargo.toml --check"
      ],
      "lint": [
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "typecheck": [
        "bun",
        "run",
        "typecheck"
      ],
      "test": [
        "bun",
        "run",
        "test"
      ],
      "build": [
        "bun",
        "run",
        "build"
      ],
      "test:integration:workflow": [
        "bash",
        "-lc",
        "bun run test:learned-provider-contract && bun run test:texture-projection && bun run test:browser-contract && bun run test:video-sampling-contract && cargo check --manifest-path crates/video-to-3d-feature-wasm/Cargo.toml --target wasm32-unknown-unknown && cargo test -p video-to-3d-core --example golden_fixture && cargo test -p video-to-3d-core --example reference_fixture && cargo test -p video-to-3d-core --example synthetic_room_fixture && python3 -m unittest discover -s tools/tests -p 'test_*.py' && python3 -m py_compile tools/fetch_tanks_and_temples.py tools/score_tanks_and_temples.py"
      ],
      "benchmark:smoke": [
        "bun",
        "run",
        "benchmark:wasm-boundary"
      ],
      "benchmark": [
        "bun",
        "run",
        "benchmark:wasm-boundary"
      ]
    }
  },
  "taskKnowledge": {
    "schemaVersion": 1,
    "scopes": [],
    "completion": {
      "command": [
        "bun",
        "run",
        "check"
      ],
      "source": "package.json"
    }
  }
}
