{
  "schema_version": "runtime-profiler/scenario/v1",
  "id": "video-to-3d-golden-rust",
  "target": {
    "type": "command",
    "program": "bash",
    "args": ["tools/run_rust_golden_runtime.sh"],
    "working_directory": "../..",
    "inherit_env": ["GOLDEN_CASE"]
